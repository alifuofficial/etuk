generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           String   @default("MARKETING_OFFICER")
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  agentProfile   Agent?   @relation("AgentUser")
  reviewedAgents Agent[]  @relation("AgentReviewer")
}

model Agent {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  email            String        @unique
  phone            String        @unique
  alternativePhone String?
  businessName     String?
  businessType     String?
  experience       String?
  region           String
  city             String
  woreda           String?
  kebele           String?
  address          String?
  hasWarehouse     Boolean       @default(false)
  warehouseSize    String?
  existingBrands   String?
  staffCount       Int?
  estimatedCapital String?
  bankName         String?
  accountNumber    String?
  tradeLicense     String?
  idDocument       String?
  tinNumber        String?       @unique
  status           String        @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  message          String?
  howDidYouHear    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contactPerson    String?
  contactPhone     String?
  userId           String?       @unique
  user             User?         @relation("AgentUser", fields: [userId], references: [id])
  reviewer         User?         @relation("AgentReviewer", fields: [reviewedBy], references: [id])
  customers        Customer[]
  inventory        Inventory[]
  units            ProductUnit[]
  sales            Sale[]
  proformas        Proforma[]
}

model Product {
  id             String                 @id @default(cuid())
  name           String
  nameAm         String?
  nameOr         String?
  description    String?
  descriptionAm  String?
  descriptionOr  String?
  category       String
  specifications String?
  price          Float?
  images         String?
  isActive       Boolean                @default(true)
  featured       Boolean                @default(false)
  isSerialized   Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  inventory      Inventory[]
  transactions   InventoryTransaction[]
  units          ProductUnit[]
  proformaItems  ProformaItem[]
}

model ProductUnit {
  id             String                 @id @default(cuid())
  productId      String
  chassisNumber  String                 @unique
  currentAgentId String?
  proformaId     String?                // Reserved for proforma
  status         String                 @default("AVAILABLE") // AVAILABLE, WITH_AGENT, SOLD, RESERVED
  isSold         Boolean                @default(false)
  soldAt         DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  agent          Agent?                 @relation(fields: [currentAgentId], references: [id])
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  proforma       Proforma?              @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  sales          Sale[]                 @relation("UnitSales")
  transactions   InventoryTransaction[] @relation("TransactionUnits")
}

model Inventory {
  id        String   @id @default(cuid())
  productId String
  agentId   String?
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, agentId])
}

model InventoryTransaction {
  id          String        @id @default(cuid())
  productId   String
  fromAgentId String?
  toAgentId   String?
  quantity    Int
  type        String
  notes       String?
  createdAt   DateTime      @default(now())
  performedBy String?
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  units       ProductUnit[] @relation("TransactionUnits")
}

model Region {
  id       String  @id @default(cuid())
  name     String
  nameAm   String?
  nameOr   String?
  code     String  @unique
  isActive Boolean @default(true)
  cities   City[]
}

model City {
  id       String  @id @default(cuid())
  name     String
  nameAm   String?
  nameOr   String?
  regionId String
  isActive Boolean @default(true)
  region   Region  @relation(fields: [regionId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Language {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  flag         String?
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]
}

model Translation {
  id         String   @id @default(cuid())
  key        String
  value      String
  languageId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([key, languageId])
}

model SmsLog {
  id           String   @id @default(cuid())
  agentId      String?
  recipient    String
  message      String
  status       String
  errorMessage String?
  sentBy       String?
  createdAt    DateTime @default(now())
}

model SmsTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Sale {
  id            String      @id @default(cuid())
  productUnitId String
  agentId       String
  customerId    String?
  customerName  String
  customerPhone String
  soldAt        DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer?   @relation(fields: [customerId], references: [id])
  agent         Agent       @relation(fields: [agentId], references: [id])
  productUnit   ProductUnit @relation("UnitSales", fields: [productUnitId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  agentId   String
  fullName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@unique([agentId, phone])
}

model Proforma {
  id              String        @id @default(cuid())
  number          String        @unique
  agentId         String
  status          String        @default("PENDING") // PENDING, PAYMENT_PENDING, PAID, EXPIRED, CANCELLED, REJECTED
  totalAmount     Float
  notes           String?
  expiresAt       DateTime
  paidAt          DateTime?
  paymentRef      String?       // Payment reference number
  paymentReceipt  String?       // Path to uploaded payment receipt file
  paymentNotes    String?       // Notes from accountant about payment
  verifiedBy      String?       // Accountant who verified the payment
  verifiedAt      DateTime?     // When payment was verified
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  agent           Agent         @relation(fields: [agentId], references: [id])
  items           ProformaItem[]
  productUnits    ProductUnit[]

  @@index([agentId])
  @@index([status])
}

model ProformaItem {
  id           String   @id @default(cuid())
  proformaId   String
  productId    String
  productName  String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime @default(now())
  proforma     Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
}
