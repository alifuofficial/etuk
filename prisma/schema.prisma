generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("MARKETING_OFFICER")
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reviewedAgents Agent[]  @relation("AgentReviewer")
  agentProfile   Agent?   @relation("AgentUser")
}

model Agent {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String    @unique
  alternativePhone String?
  businessName     String?
  businessType     String?
  experience       String?
  region           String
  city             String
  woreda           String?
  kebele           String?
  address          String?
  hasWarehouse     Boolean   @default(false)
  warehouseSize    String?
  existingBrands   String?
  staffCount       Int?
  estimatedCapital String?
  bankName         String?
  accountNumber    String?
  tradeLicense     String?
  idDocument       String?
  tinNumber        String?   @unique
  status           String    @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  message          String?
  howDidYouHear    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contactPerson    String?
  contactPhone     String?
  reviewer         User?     @relation("AgentReviewer", fields: [reviewedBy], references: [id])
  userId           String?   @unique
  user             User?     @relation("AgentUser", fields: [userId], references: [id])
  inventory        Inventory[]
  units            ProductUnit[]
  sales            Sale[]
  customers        Customer[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  nameAm         String?
  nameOr         String?
  description    String?
  descriptionAm  String?
  descriptionOr  String?
  category       String
  specifications String?
  price          Float?
  images         String?
  isActive       Boolean  @default(true)
  featured       Boolean  @default(false)
  isSerialized   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inventory      Inventory[]
  transactions   InventoryTransaction[]
  units          ProductUnit[]
}

model ProductUnit {
  id            String   @id @default(cuid())
  productId     String
  chassisNumber String   @unique
  currentAgentId String? // null = Warehouse
  status        String   @default("AVAILABLE") // AVAILABLE, SOLD, MAINTENANCE
  isSold        Boolean  @default(false)
  soldAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  agent         Agent?   @relation(fields: [currentAgentId], references: [id], onDelete: SetNull)
  transactions  InventoryTransaction[] @relation("TransactionUnits")
  sales         Sale[]   @relation("UnitSales")
}

model Inventory {
  id        String   @id @default(cuid())
  productId String
  agentId   String?  // null represents the central Warehouse
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([productId, agentId])
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  productId       String
  fromAgentId     String?  // source (null = Warehouse)
  toAgentId       String?  // destination (null = Warehouse)
  quantity        Int
  type            String   // e.g., "INITIAL_STOCK", "TRANSFER", "SALE", "RETURN"
  notes           String?
  createdAt       DateTime @default(now())
  performedBy     String?  // User id who did the transaction
  
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  units   ProductUnit[] @relation("TransactionUnits")
}

model Region {
  id       String  @id @default(cuid())
  name     String
  nameAm   String?
  nameOr   String?
  code     String  @unique
  isActive Boolean @default(true)
  cities   City[]
}

model City {
  id       String  @id @default(cuid())
  name     String
  nameAm   String?
  nameOr   String?
  regionId String
  isActive Boolean @default(true)
  region   Region  @relation(fields: [regionId], references: [id])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Language {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  flag         String?
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]
}

model Translation {
  id         String   @id @default(cuid())
  key        String
  value      String
  languageId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([key, languageId])
}

model SmsLog {
  id           String   @id @default(cuid())
  agentId      String?
  recipient    String
  message      String
  status       String   // "success" | "failed"
  errorMessage String?
  sentBy       String?
  createdAt    DateTime @default(now())
}

model SmsTemplate {
  id        String   @id @default(cuid())
  name      String   @unique // AGENT_APPLIED, AGENT_APPROVED, AGENT_REJECTED
  content   String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Sale {
  id            String   @id @default(cuid())
  productUnitId String
  agentId       String
  customerId    String?
  customerName  String
  customerPhone String
  soldAt        DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], name: "UnitSales")
  agent       Agent       @relation(fields: [agentId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Customer {
  id        String   @id @default(cuid())
  agentId   String
  fullName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@unique([agentId, phone])
}
